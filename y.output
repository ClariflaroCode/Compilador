  77  parametros_formales : tipo ID
  78                      | tipo ID ',' parametros_formales

  79  invocacion_funcion : ID '(' parametros_reales ')'

  80  parametros_reales : expr_asig
  81                    | expr_asig ',' parametros_reales

  82  retorno : RET '(' expr ')'

  83  cadena : STRING

  84  print : POUT '(' expr ')'
