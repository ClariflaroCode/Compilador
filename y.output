   0  $accept : programa $end

   1  programa : ID sentencias_declarativas bloque_ejecutable
   2           | error sentencias_declarativas bloque_ejecutable

   3  if : IF '(' comp ')' bloque_ejecutable END_IF
   4     | IF '(' comp ')' bloque_ejecutable ELSE bloque_ejecutable END_IF
   5     | IF '(' comp ')' sentencia_ejecutable END_IF
   6     | IF '(' comp ')' sentencia_ejecutable ELSE sentencia_ejecutable END_IF
   7     | IF '(' comp ')' bloque_ejecutable ELSE sentencia_ejecutable END_IF
   8     | IF '(' comp ')' sentencia_ejecutable ELSE bloque_ejecutable END_IF

   9  bloque_ejecutable : BEGIN sentencias_ejecutables END

  10  sentencias_ejecutables : sentencia_ejecutable
  11                         | sentencia_ejecutable sentencias_ejecutables

  12  sentencia_ejecutable : assign ';'
  13                       | if ';'
  14                       | while_repeat ';'
  15                       | print ';'

  16  sentencias_declarativas : sentencia_declarativa
  17                          | sentencia_declarativa sentencias_declarativas

  18  sentencia_declarativa : declaracion_var ';'
  19                        | funcion ';'
  20                        | clase ';'
  21                        | enum ';'

  22  clase : CLASS ID BEGIN cuerpo_clase END
  23        | CLASS ID cuerpo_clase END

  24  cuerpo_clase : sent_clase
  25               | sent_clase cuerpo_clase

  26  sent_clase : metodo ';'
  27             | atributo ';'
  28             | friendly ';'
  29             | herencia ';'

  30  metodo : PRIVATE tipo ID '(' parametros_formales ')' sentencias_declarativas bloque_func
  31         | PRIVATE AUTO ID '(' parametros_formales ')' sentencias_declarativas bloque_retorno
  32         | tipo ID '(' parametros_formales ')' sentencias_declarativas bloque_func
  33         | AUTO ID '(' parametros_formales ')' sentencias_declarativas bloque_retorno

  34  bloque_func : bloque_retorno
  35              | bloque_ejecutable

  36  bloque_retorno : BEGIN sentencias_retornables END

  37  sentencias_func : sent_func
  38                  | sentencias_func sent_func

  39  sentencias_retornables : sentencia_retornable
  40                         | sentencias_func sentencia_retornable

  41  sent_func : sentencia_ejecutable
  42            | sentencia_retornable
  43            | if_func ';'
  44            | while_repeat_func ';'

  45  sentencia_retornable : retorno ';'
  46                       | if_retorno_seguro ';'

  47  if_retorno_seguro : IF '(' comp ')' bloque_retorno ELSE bloque_retorno END_IF
  48                    | IF '(' comp ')' retorno ELSE retorno END_IF
  49                    | IF '(' comp ')' bloque_retorno ELSE retorno END_IF
  50                    | IF '(' comp ')' retorno ELSE bloque_retorno END_IF

  51  if_func : IF '(' comp ')' bloque_func END_IF
  52          | IF '(' comp ')' sent_func END_IF

  53  while_repeat_func : WHILE '(' comp ')' REPEAT bloque_func
  54                    | WHILE '(' comp ')' REPEAT sent_func

  55  atributo : declaracion_var
  56           | enum
  57           | PRIVATE enum
  58           | PRIVATE declaracion_var

  59  friendly : FRIEND ID

  60  herencia : EXTENDS lista_de_variables

  61  declaracion_var : tipo lista_de_variables
  62                  | tipo ID

  63  lista_de_variables : ID
  64                     | ID ',' lista_de_variables

  65  lista_valores : cte
  66                | cte ',' lista_valores

  67  tipo : UNINTEGER
  68       | DOUBLEF
  69       | ID

  70  funcion : tipo FUNCTION ID '(' parametros_formales ')' sentencias_declarativas bloque_ejecutable
  71          | AUTO FUNCTION ID '(' parametros_formales ')' sentencias_declarativas bloque_retorno

  72  parametros_formales : tipo ID
  73                      | tipo ID ',' parametros_formales

  74  invocacion_funcion : ID '(' parametros_reales ')'

  75  parametros_reales : expr_asig
  76                    | expr_asig ',' parametros_reales

  77  retorno : RET '(' expr ')'

  78  cadena : STRING

  79  print : POUT '(' expr ')'
  80        | POUT '(' cadena ')'

  81  enum : TYPEDEF ID '=' '[' lista_valores ']'

  82  while_repeat : WHILE '(' comp ')' REPEAT bloque_ejecutable
  83               | WHILE '(' comp ')' REPEAT sentencia_ejecutable

  84  comp : expr_asig '<' expr_asig
  85       | expr_asig '>' expr_asig
  86       | expr_asig MAYOR_IGUAL expr_asig
  87       | expr_asig MENOR_IGUAL expr_asig
  88       | expr_asig DISTINTO expr_asig
  89       | expr_asig IGUALDAD expr_asig

  90  assign : ID OP_ASSIGN expr_asig
  91         | ID '=' expr

  92  expr_asig : expr
  93            | expr '=' expr

  94  expr : expr '+' term
  95       | expr '-' term
  96       | term

  97  term : term '/' factor
  98       | term '*' factor
  99       | factor

 100  factor : variable
 101         | cte
 102         | invocacion_funcion

 103  variable : ID
 104           | ID '.' ID
 105           | ID '.' invocacion_funcion

 106  cte : CTE_ENTERA
 107      | CTE_DOUBLE

