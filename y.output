  34  metodo : PRIVATE tipo ID '(' parametros_formales ')' sentencias_declarativas bloque_func
  35         | PRIVATE AUTO ID '(' parametros_formales ')' sentencias_declarativas bloque_retorno
  36         | tipo ID '(' parametros_formales ')' sentencias_declarativas bloque_func
  37         | AUTO ID '(' parametros_formales ')' sentencias_declarativas bloque_retorno

  38  bloque_func : bloque_retorno
  39              | bloque_ejecutable

  40  bloque_retorno : BEGIN sentencias_retornables END

  41  sentencias_func : sent_func
  42                  | sentencias_func sent_func

  43  sentencias_retornables : sentencia_retornable
  44                         | sentencias_func sentencia_retornable

  45  sent_func : sentencia_ejecutable
  46            | sentencia_retornable
  47            | if_func ';'
  48            | while_repeat_func ';'

  49  sentencia_retornable : retorno ';'
  50                       | if_retorno_seguro ';'

  51  if_retorno_seguro : IF '(' comp ')' bloque_retorno ELSE bloque_retorno END_IF
  52                    | IF '(' comp ')' retorno ELSE retorno END_IF
  53                    | IF '(' comp ')' bloque_retorno ELSE retorno END_IF
  54                    | IF '(' comp ')' retorno ELSE bloque_retorno END_IF

  55  if_func : IF '(' comp ')' bloque_func END_IF
  56          | IF '(' comp ')' sent_func END_IF

  57  while_repeat_func : WHILE '(' comp ')' REPEAT bloque_func
  58                    | WHILE '(' comp ')' REPEAT sent_func

  59  atributo : declaracion_var
  60           | enum
  61           | PRIVATE enum
  62           | PRIVATE declaracion_var

  63  friendly : FRIEND ID

  64  herencia : EXTENDS lista_de_variables
